[Unit]
Description=Actualiser les relevés des tableaux thématiques ASC
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=mombo
WorkingDirectory=/opt/moh_superset/superset_config/asc-v2
ExecStart=/usr/bin/docker exec superset_app python -u /app/superset_config/asc-v2/refresh_themes.py
TimeoutStartSec=2700
