[Unit]
Description=Actualiser les listes opérationnelles ASC et enfants signalés zéro dose
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=mombo
WorkingDirectory=/opt/moh_superset/superset_config/asc-v2
ExecStart=/usr/bin/docker exec superset_app python -u /app/superset_config/asc-v2/refresh_operational.py
TimeoutStartSec=1500
