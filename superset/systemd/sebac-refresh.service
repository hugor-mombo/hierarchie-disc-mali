[Unit]
Description=Actualiser les relevés SEBAC DISC de suivi des alertes
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=mombo
WorkingDirectory=/opt/moh_superset/superset_config/asc-v2
ExecStart=/usr/bin/docker exec superset_app python -u /app/superset_config/asc-v2/refresh_sebac.py
TimeoutStartSec=1500
