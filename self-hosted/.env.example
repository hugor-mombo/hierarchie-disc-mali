# Copier dans .env (chmod 600). Ne jamais committer de vrais secrets.
SITE_DOMAIN=maintenance.disc-mali.ml
APP_URL=https://maintenance.disc-mali.ml
ACME_EMAIL=administrateur@example.org
POSTGRES_DB=hierarchie
POSTGRES_USER=hierarchie
# Utiliser une chaîne hexadécimale de 64 caractères (sans caractères réservés URL).
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
# Accès de lecture. Ne pas mettre les identifiants dans les URL.
DISC_URL=https://disc-mali.ml
DISC_USER=
DISC_PASSWORD=
DHIS_URL=https://dhis2.snissmali.ml/dhis
DHIS_USER=
DHIS_PASSWORD=
# Comptes techniques d’écriture ; si vides, utilisation des comptes ci-dessus.
DISC_WRITE_USER=
DISC_WRITE_PASSWORD=
DHIS_WRITE_USER=
DHIS_WRITE_PASSWORD=
# Activer seulement après recette sur des instances de test et configuration des rôles.
ENABLE_REMOTE_WRITES=false
PLAN_MAX_AGE_MINUTES=60
ALLOW_HTTP_SOURCES=false

# Jetons techniques OpenFn distincts, aléatoires (au moins 32 caractères).
# Vides : API interopérabilité désactivée. Ne pas réutiliser un mot de passe utilisateur.
OPENFN_MAPPING_TOKEN=
OPENFN_AUDIT_TOKEN=
